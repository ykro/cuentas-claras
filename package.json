  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/ui": "^5.1.0",
    "firebase-tools": "^15.34.2",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
